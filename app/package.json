{
  "name": "constellate-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fixture": "cd .. && uv run --project pipeline python app/scripts/make_fixture.py",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "explain": "tsx scripts/precompute-explain.ts",
    "test:unit": "node --import tsx --test lib/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
