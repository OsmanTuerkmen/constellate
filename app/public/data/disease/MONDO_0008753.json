{"node":{"id":"MONDO:0008753","label":"alkaptonuria","definition":"A metabolic disease characterized by the accumulation of homogentisic acid (HGA) and its oxidized product, benzoquinone acetic acid (BQA), in various tissues (e.g. cartilage, connective tissue) and body fluids (urine, sweat), causing urine to darken when exposed to air as well as grey-blue coloration of the sclera and ear helix (ochronosis), and a disabling joint disease involving both the axial and peripheral joints (ochronotic arthropathy).","synonyms":["aku","alcaptonuria","alkaptonuric ochronosis","hereditary ochronosis","homogentisate 1,2-dioxygenase deficiency","homogentisic acid oxidase deficiency","homogentisic acidura","ochronosis, hereditary"],"xrefs":["DOID:9270","GARD:0005775","ICD9:270.2","MEDGEN:1413","MESH:D000474","MedDRA:10001689","NANDO:2200504","NCIT:C84546","NORD:750","OMIM:203500","Orphanet:56","SCTID:360378009","UMLS:C0002066","icd11.foundation:1761652827"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":null,"is_group":false,"n_genes":1,"n_phenotypes":62,"mechanism_classes":[{"key":"amino_organic_acid","label":"amino acid / organic acid metabolism","via":"MONDO:0004736","via_label":"inborn disorder of amino acid metabolism"}]},"genes":[{"id":"e_8540cd315a8c","source":"MONDO:0008753","target":"HGD","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:56","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/56","confidence":0.95,"snippet":"Disease-causing germline mutation(s) (loss of function) in (Assessed) — homogentisate 1,2-dioxygenase"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:56","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:56","snippet":"HGD is annotated as disease gene of ORPHA:56 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"