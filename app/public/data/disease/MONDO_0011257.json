{"node":{"id":"MONDO:0011257","label":"MPI-congenital disorder of glycosylation","definition":"MPI-CDG is a form of congenital disorders of N-linked glycosylation, characterized by cyclic vomiting, profound hypoglycemia, failure to thrive, liver fibrosis, gastrointestinal complications (protein-losing enteropathy with hypoalbuminaemia, life-threatening intestinal bleeding of diffuse origin), and thrombotic events (protein C and S deficiency, low anti-thrombine III levels), whereas neurological development and cognitive capacity is usually normal. The clinical course is variable even within families. The disease is caused by loss of function of the gene MPI (15q24.1).","synonyms":["CDG 1B","CDG gastrointestinal type","CDG syndrome type IB","CDG-Ib","CDG1B","MPI-CDG","MPI-CDG (CDG-Ib)","SLSJ syndrome"],"xrefs":["DOID:0080554","GARD:0009830","ICD9:277.6","MEDGEN:400692","MESH:C535740","OMIM:602579","Orphanet:79319","SCTID:124668009","UMLS:C1865145","icd11.foundation:803079134"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":4,"is_group":false,"n_genes":1,"n_phenotypes":33,"mechanism_classes":[{"key":"glycosylation","label":"congenital disorder of glycosylation","via":"MONDO:0015286","via_label":"congenital disorder of glycosylation"}]},"genes":[{"id":"e_23a41a5324e2","source":"MONDO:0011257","target":"MPI","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:79319","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/79319","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — mannose phosphate isomerase"},{"db":"HPO","origin":"OMIM","record":"OMIM:602579","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://omim.org/entry/602579","snippet":"MPI is annotated as disease gene of OMIM:602579 (HPO genes_to_phenotype, OMIM-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["OMIM","Orphanet"],"level