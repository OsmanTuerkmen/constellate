{"node":{"id":"MONDO:0035472","label":"GJC2-related late-onset primary lymphedema","definition":"A rare genetic primary lymphedema characterized by lymphedema of all four limbs with age of onset ranging from birth to adulthood. Manifestations are of variable severity, and upper limb involvement may develop only later in the disease course. Recurrent episodes of cellulitis and skin infections are observed in severe cases. Varicose veins and venous incompetence have been reported in association.","synonyms":[],"xrefs":["GARD:0022299","MEDGEN:1809328","Orphanet:568051","UMLS:C5681305"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":0,"is_group":false,"n_genes":1,"n_phenotypes":13,"mechanism_classes":[]},"genes":[{"id":"e_7832dca32278","source":"MONDO:0035472","target":"GJC2","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:568051","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/568051","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — gap junction protein gamma 2"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:568051","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:568051","snippet":"GJC2 is annotated as disease gene of ORPHA:568051 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_abdee7aa7aba","source":"MONDO:0035472","target":"HP:0003759","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:568051 · ORPHA:568051","url":"https://www.orpha.net/en/disease/detail/568051","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"GJC2-related late-onset primary lymphedema: Hypoplasia of lymphatic vessels (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:568051","level":"curated