{"node":{"id":"MONDO:0014911","label":"growth retardation, intellectual developmental disorder, hypotonia, and hepatopathy","definition":"A rare, genetic, syndromic intellectual disability disease characterized by severe intrauterine and post-natal growth delay, moderate to severe intellectual disability, and neonatal-onset hepatopathy with fibrosis, steatosis, and/or cholestasis, occasionally leading to liver failure. Additional variable manifestations include muscular hypotonia, zinc deficiency, recurrent infections, diabetes mellitus, joint contractures, skin and joint laxity, hypervitaminosis D, and sensorineural hearing loss.","synonyms":["GRIDHH","Growth retardation, intellectual developmental disorder, hypotonia, and hepatopathy","growth retardation, impaired intellectual development, hypotonia, and hepatopathy","growth retardation, intellectual developmental disorder, hypotonia, and hepatopathy; GRIDHH"],"xrefs":["GARD:0017980","MEDGEN:934687","OMIM:617093","Orphanet:541423","UMLS:C4310720"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":6,"is_group":false,"n_genes":1,"n_phenotypes":51,"mechanism_classes":[]},"genes":[{"id":"e_fb82f341d8a9","source":"MONDO:0014911","target":"IARS1","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:541423","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/541423","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — isoleucyl-tRNA synthetase 1"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:541423","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:541423","snippet":"IARS1 is annotated as disease gene of ORPHA:541423 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_c43eff063fb0","source":"MONDO:0014911","target