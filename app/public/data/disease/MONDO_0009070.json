{"node":{"id":"MONDO:0009070","label":"D-glyceric aciduria","definition":"A metabolic disorder characterized by D-glyceric acid excretion. It has been described in several patients. Clinical findings include progressive neurological impairment, hypotonia, seizures, failure to thrive and metabolic acidosis. Some patients had hyperglycinemia secondary to the organic acidemia. However, some of the reported patients were asymptomatic. D-glyceric aciduria is caused by D-glycerate kinase deficiency. The GLYCTK gene has been mapped to 3p21.","synonyms":["D-glycerate kinase deficiency","D-glyceric acidemia","D-glycericacidemia","d-glyceric aciduria","non ketotic hyperglycinemia syndrome"],"xrefs":["DOID:0111626","GARD:0000234","MEDGEN:452447","MESH:C535767","NCIT:C128804","OMIM:220120","Orphanet:941","SCTID:237980004","UMLS:C0342765"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":7,"is_group":false,"n_genes":1,"n_phenotypes":58,"mechanism_classes":[]},"genes":[{"id":"e_98a96fd37638","source":"MONDO:0009070","target":"GLYCTK","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:941","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/941","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — glycerate kinase"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:941","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:941","snippet":"GLYCTK is annotated as disease gene of ORPHA:941 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_d9bcc12d3d55","source":"MONDO:0009070","target":"HP:0034706","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:220120 · PMID:2537226","url":"https://pubmed.ncbi.nlm.nih.gov/2537226/","level":"observed","date":"2023-06-