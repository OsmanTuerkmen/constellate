{"node":{"id":"MONDO:0007906","label":"familial partial lipodystrophy, Dunnigan type","definition":"Familial Partial lipodystrophy, Dunnigan type (FPLD2) is a rare form of genetic lipodystrophy characterized by a loss of subcutaneous adipose tissue from the trunk, buttocks and limbs; fat accumulation in the neck, face, axillary and pelvic regions; muscular hypertrophy; and usually associated with metabolic complications such as insulin resistance, diabetes mellitus, dyslipidemia and liver steatosis.","synonyms":["Dunnigan syndrome","FPL2","FPLD2","familial partial lipodystrophy type 2","lipodystrophy, familial partial, type 2"],"xrefs":["DOID:0070202","GARD:0003126","MEDGEN:354526","OMIM:151660","Orphanet:2348","SCTID:715439000","UMLS:C1720860","icd11.foundation:2068585355"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":9,"is_group":false,"n_genes":1,"n_phenotypes":82,"mechanism_classes":[]},"genes":[{"id":"e_1e18286143fb","source":"MONDO:0007906","target":"LMNA","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:2348","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/2348","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — lamin A/C"},{"db":"HPO","origin":"OMIM","record":"OMIM:151660","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://omim.org/entry/151660","snippet":"LMNA is annotated as disease gene of OMIM:151660 (HPO genes_to_phenotype, OMIM-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["OMIM","Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_a0efc954b7d7","source":"MONDO:0007906","target":"HP:0000287","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:151660 · PMID:17250669","url":"https://pubmed.ncbi.nlm.nih.gov/17250669/","level":"observed","date":"2024-11-08","confidence":1.0,"snippet":"Lipodystrophy, familial partial, type 2: