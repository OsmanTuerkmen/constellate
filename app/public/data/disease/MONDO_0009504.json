{"node":{"id":"MONDO:0009504","label":"mitochondrial DNA depletion syndrome 9","definition":"Fatal infantile lactic acidosis with methylmalonic aciduria is a rare neurometabolic disease characterized by infantile onset of severe encephalomyopathy, lactic acidosis and elevated methylmalonic acid urinary excretion. Clinically it manifests with severe psychomotor delay, hypotonia, failure to thrive, feeding difficulties and dystonia. Epilepsy and multiple congenital anomalies may be associated.","synonyms":["MTDPS9","SUCLG1 mitochondrial DNA depletion syndrome","lactic acidosis congenital infantile","lactic acidosis, fatal infantile","mitochondrial DNA depletion syndrome 9 (encephalomyopathic type with methylmalonic aciduria)","mitochondrial DNA depletion syndrome caused by mutation in SUCLG1","mitochondrial DNA depletion syndrome type 9","succinate-CoA ligase deficiency"],"xrefs":["DOID:0080128","GARD:0003163","MEDGEN:462826","MESH:C538134","MESH:C566885","OMIM:245400","Orphanet:17","SCTID:715338007","UMLS:C3151476"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":null,"is_group":false,"n_genes":1,"n_phenotypes":86,"mechanism_classes":[{"key":"mitochondrial","label":"mitochondrial energy metabolism","via":"MONDO:0004069","via_label":"inborn mitochondrial metabolism disorder"}]},"genes":[{"id":"e_0b255a2aa067","source":"MONDO:0009504","target":"SUCLG1","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:17","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/17","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — succinate-CoA ligase GDP/ADP-forming subunit alpha"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:17","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:17","snippet":"SUCLG1 is annotated as disease gene of ORPHA:17 (HPO genes_to_phenotype, Orphanet-derived)"}],"co