{"node":{"id":"MONDO:0013686","label":"distal myopathy, Tateyama type","definition":"Distal myopathy, Tateyama type is a rare, genetic, slowly progressive, distal myopathy disorder characterized by muscle atrophy and weakness limited to the small muscles of the hands and feet (in particular, thenar and hypothenar muscle atrophy), increased serum creatine kinase, and severely reduced caveolin-3 expression on muscle biopsy. Some patients may also show calf hypertrophy, pes cavus, and signs of muscle hyperexcitability.","synonyms":["MPDT","myopathy, distal, Tateyama type"],"xrefs":["DOID:0111191","GARD:0017900","MEDGEN:482073","OMIM:614321","Orphanet:488650","SCTID:711265009","UMLS:C3280443"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":9,"is_group":false,"n_genes":1,"n_phenotypes":25,"mechanism_classes":[]},"genes":[{"id":"e_b05b89e6cc02","source":"MONDO:0013686","target":"CAV3","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:488650","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/488650","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — caveolin 3"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:488650","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:488650","snippet":"CAV3 is annotated as disease gene of ORPHA:488650 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_ac8b95ebf96c","source":"MONDO:0013686","target":"HP:0008954","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:614321 · PMID:11805270","url":"https://pubmed.ncbi.nlm.nih.gov/11805270/","level":"observed","date":"2022-10-23","confidence":1.0,"snippet":"Myopathy, distal, Tateyama type: Intrinsic hand muscle atrophy (frequency 1/1) [PCS]"},{"db":"HPO","o