{"node":{"id":"MONDO:0010184","label":"methylmalonic aciduria and homocystinuria type cblC","definition":"A form of methylmalonic acidemia with homocystinuria, an inborn error of vitamin B12 (cobalamin) metabolism characterized by megaloblastic anemia, lethargy, failure to thrive, developmental delay, intellectual deficit and seizures. cblC type methylmalonic acidemia with homocystinuria is caused by mutations in the MMACHC gene (1p36.3) and is transmitted in an autosomal recessive manner.","synonyms":["MAHCC","cblC","cblC defect","cobalamin C defect","cobalamin c disease","combined defect in adenosylcobalamin and methylcobalamin synthesis, type cblC","methylmalonic acidemia and homocystinuria cblC","methylmalonic acidemia with homocystinuria type cblC"],"xrefs":["DOID:0050715","GARD:0012128","MEDGEN:341256","NANDO:1201040","NANDO:2201107","NCIT:C142174","OMIM:277400","Orphanet:79282","SCTID:74653006","UMLS:C1848561"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":null,"is_group":false,"n_genes":2,"n_phenotypes":105,"mechanism_classes":[{"key":"amino_organic_acid","label":"amino acid / organic acid metabolism","via":"MONDO:0004736","via_label":"inborn disorder of amino acid metabolism"}]},"genes":[{"id":"e_6f50768a13e6","source":"MONDO:0010184","target":"MMACHC","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:79282","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/79282","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — metabolism of cobalamin associated C"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:79282","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:79282","snippet":"MMACHC is annotated as disease gene of ORPHA:79282 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"level":"curated"}