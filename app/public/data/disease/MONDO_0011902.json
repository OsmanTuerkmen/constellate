{"node":{"id":"MONDO:0011902","label":"Charcot-Marie-Tooth disease type 1F","definition":"A form of CMT1, with a variable clinical presentation that can range from severe impairment with onset in childhood to mild impairment appearing during adulthood. CMT1F is characterized by a progressive peripheral motor and sensory neuropathy with distal paresis in the lower limbs that varies from mild weakness to complete paralysis of the distal muscle groups, absent tendon reflexes and reduced nerve conduction. CMT1F represents the ''demyelinating'' form of CMT2E and is caused by mutations in the NEFL gene (8p21.2)..","synonyms":["CMT 1F","CMT1F","Charcot Marie Tooth disease type 1F","Charcot-Marie-Tooth disease type 1 caused by mutation in NEFL","Charcot-Marie-Tooth disease, demyelinating, type 1F","Charcot-Marie-Tooth disease, type 1F","NEFL Charcot-Marie-Tooth disease type 1"],"xrefs":["DOID:0110149","GARD:0009191","MEDGEN:334337","MESH:C537987","OMIM:607734","Orphanet:101085","SCTID:719980006","UMLS:C1843164","icd11.foundation:1160290076"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":null,"is_group":false,"n_genes":1,"n_phenotypes":62,"mechanism_classes":[]},"genes":[{"id":"e_a84e43ee235f","source":"MONDO:0011902","target":"NEFL","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:101085","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/101085","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — neurofilament light chain"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:101085","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:101085","snippet":"NEFL is annotated as disease gene of ORPHA:101085 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_259b3e684eb1