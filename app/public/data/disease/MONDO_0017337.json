{"node":{"id":"MONDO:0017337","label":"inherited isolated adrenal insufficiency due to partial CYP11A1 deficiency","definition":"Inherited isolated adrenal insufficiency due to partial CYP11A1 deficiency is a rare, genetic, chronic, primary adrenal insufficiency disorder, due to partial loss-of-function CYP11A1 mutations, characterized by early-onset adrenal insufficiency without associated abnormal external male genitalia. Patients present with signs of adrenal crisis, including electrolite abnormalities, severe weakness, recurrent vomiting and seizures. Ultrasound reveals absent (or very small) adrenal glands.","synonyms":[],"xrefs":["GARD:0021143","MEDGEN:1643960","Orphanet:289548","SCTID:764960005","UMLS:C4707238"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":4,"is_group":false,"n_genes":1,"n_phenotypes":52,"mechanism_classes":[]},"genes":[{"id":"e_578102cf3e48","source":"MONDO:0017337","target":"CYP11A1","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:289548","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/289548","confidence":0.95,"snippet":"Disease-causing germline mutation(s) (loss of function) in (Assessed) — cytochrome P450 family 11 subfamily A member 1"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:289548","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:289548","snippet":"CYP11A1 is annotated as disease gene of ORPHA:289548 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_7ca0956f55a4","source":"MONDO:0017337","target":"HP:0008073","type":"has_phenotype","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:289548","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/289548","confidence":0.9,"snippet":"Low maternal