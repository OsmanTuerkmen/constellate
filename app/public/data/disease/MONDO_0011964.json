{"node":{"id":"MONDO:0011964","label":"DPAGT1-congenital disorder of glycosylation","definition":"DPAGT1-CDG is a form of congenital disorders of N-linked glycosylation characterized by hypotonia, intractable seizures, developmental delay, microcephaly and severe fetal hypokinesia. Additional features that may be observed include apnea and respiratory deficiency, cataracts, joint contractures, vermian hypoplasia, dysmorphic features (esotropia, arched palate, micrognathia, finger clinodactyly, single flexion creases) and feeding difficulties. The disease is caused by loss-of-function mutations in the gene DPAGT1 (11q23.3).","synonyms":["CDG 1J","CDG syndrome type Ij","CDG-Ij","CDG1J","CDGIj","DPAGT1-CDG","DPAGT1-CDG (CDG-Ij)","carbohydrate deficient glycoprotein syndrome type Ij"],"xrefs":["DOID:0080562","GARD:0009837","MEDGEN:419694","MESH:C535748","NCIT:C126874","OMIM:608093","Orphanet:86309","SCTID:725079003","UMLS:C2931004"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":3,"is_group":false,"n_genes":1,"n_phenotypes":85,"mechanism_classes":[{"key":"glycosylation","label":"congenital disorder of glycosylation","via":"MONDO:0015286","via_label":"congenital disorder of glycosylation"}]},"genes":[{"id":"e_bfb2b5a58716","source":"MONDO:0011964","target":"DPAGT1","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:86309","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/86309","confidence":0.95,"snippet":"Disease-causing germline mutation(s) (loss of function) in (Assessed) — dolichyl-phosphate N-acetylglucosaminephosphotransferase 1"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:86309","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:86309","snippet":"DPAGT1 is annotated as disease gene of ORPHA:86309 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_s