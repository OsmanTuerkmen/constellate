{"node":{"id":"MONDO:0700325","label":"Parkes Weber syndrome","definition":"A rare congenital complex vascular malformation syndrome characterized by overgrowth of a limb (most commonly a leg) involving bones and soft tissue, in association with capillary malformations usually in the form of port-wine stains and multiple arteriovenous fistulas with high-flow arteriovenous shunting. The latter can also lead to other severe complications including abnormal bleeding and heart failure. Lymphatic malformations may also be present.","synonyms":["PWS"],"xrefs":["MEDGEN:1808056","Orphanet:90307","UMLS:C5574870"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":null,"is_group":false,"n_genes":1,"n_phenotypes":44,"mechanism_classes":[]},"genes":[{"id":"e_0e8598f5b9ec","source":"MONDO:0700325","target":"RASA1","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:90307","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/90307","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — RAS p21 protein activator 1"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:90307","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://hpo.jax.org/browse/disease/ORPHA:90307","snippet":"RASA1 is annotated as disease gene of ORPHA:90307 (HPO genes_to_phenotype, Orphanet-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_e9d3be8c5e74","source":"MONDO:0700325","target":"HP:0032555","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:90307 · ORPHA:90307","url":"https://www.orpha.net/en/disease/detail/90307","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Parkes Weber syndrome: Bounding pulse (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:90307","level":"curated","date":"2026-06-23"