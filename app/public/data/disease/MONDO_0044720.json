{"node":{"id":"MONDO:0044720","label":"cerebellar ataxia with neuropathy and bilateral vestibular areflexia syndrome","definition":"An autosomal recessive syndromic cerebellar ataxia caused by variation in the RFC1 gene, characterized by late-onset cerebellar dysfunction (including gait and limb ataxia, nystagmus, and dysarthria), bilateral vestibulopathy (abnormal vestibulo-ocular reflex), and axonal sensory neuropathy. Variable features may include chronic cough and autonomic dysfunction. Brain imaging usually shows cerebellar atrophy.","synonyms":["CABV syndrome","CANVAS","HSAN with cough and gastroesophageal reflux","HSAN1B","HSN1B","cerebellar ataxia with bilateral vestibulopathy syndrome","cerebellar ataxia, neuropathy, and vestibular areflexia syndrome","hereditary sensory and autonomic neuropathy type 1 with cough and gastroesophageal reflux"],"xrefs":["DOID:0070148","GARD:0017937","MEDGEN:482853","MESH:C564296","OMIM:608088","OMIM:614575","Orphanet:139564","Orphanet:504476","SCTID:717825008","UMLS:C3281223"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":3,"is_group":false,"n_genes":1,"n_phenotypes":37,"mechanism_classes":[]},"genes":[{"id":"e_3455a993f9cf","source":"MONDO:0044720","target":"RFC1","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:504476","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/504476","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — replication factor C subunit 1"},{"db":"HPO","origin":"OMIM","record":"OMIM:614575","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://omim.org/entry/614575","snippet":"RFC1 is annotated as disease gene of OMIM:614575 (HPO genes_to_phenotype, OMIM-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["OMIM","Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_becb7614faa4","source":"MONDO:0044720","target":