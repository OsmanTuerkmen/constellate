{"node":{"id":"MONDO:0011113","label":"Charcot-Marie-Tooth disease type 4C","definition":"Charcot-Marie-Tooth disease type 4C (CMT4C) is a subtype of Charcot-Marie-Tooth type 4 characterized by childhood or adolescent-onset of a relatively mild, demyelinating sensorimotor neuropathy that contrasts with a severe, rapidly progressing, early-onset scoliosis, and the typical CMT phenotype (i.e. distal muscle weakness and atrophy, sensory loss, and often foot deformity). A wide spectrum of nerve conduction velocities are observed and cranial nerve involvement and kyphoscoliosis have also been reported.","synonyms":["CMT 4C","CMT4C","Charcot Marie Tooth disease type 4C","Charcot-Marie-Tooth disease type 4 caused by mutation in SH3TC2","Charcot-Marie-Tooth disease, type 4C","SH3TC2 Charcot-Marie-Tooth disease type 4"],"xrefs":["DOID:0110183","GARD:0009201","MEDGEN:356581","MESH:C535423","NCIT:C129864","OMIM:601596","Orphanet:99949","SCTID:715797002","UMLS:C1866636","icd11.foundation:382219984"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":null,"is_group":false,"n_genes":1,"n_phenotypes":66,"mechanism_classes":[]},"genes":[{"id":"e_2fdc8f44644b","source":"MONDO:0011113","target":"SH3TC2","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:99949","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/99949","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — SH3 domain and tetratricopeptide repeats 2"},{"db":"HPO","origin":"OMIM","record":"OMIM:601596","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://omim.org/entry/601596","snippet":"SH3TC2 is annotated as disease gene of OMIM:601596 (HPO genes_to_phenotype, OMIM-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["OMIM","Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_d0276c073e2a","source":"MONDO:0011113","target":"HP:0003444",