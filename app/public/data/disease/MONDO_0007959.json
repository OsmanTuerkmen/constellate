{"node":{"id":"MONDO:0007959","label":"medulloblastoma","definition":"A malignant, invasive embryonal neoplasm arising from the cerebellum. It occurs predominantly in children and has the tendency to metastasize via the cerebrospinal fluid pathways. Signs and symptoms include truncal ataxia, disturbed gait, lethargy, headache, and vomiting. There are four histologic variants: classic medulloblastoma, large cell/anaplastic medulloblastoma, desmoplastic/nodular medulloblastoma, and medulloblastoma with extensive nodularity.","synonyms":["CPNET","MDB","cerebellum embryonal neoplasm","infratentorial primitive neuroectodermal tumour","localised primitive neuroectodermal tumour","medulloblastoma, autosomal recessive, autosomal dominant, somatic mutation","medulloblastoma, desmoplastic, autosomal recessive, autosomal dominant, somatic mutation","medulloblastoma, malignant"],"xrefs":["DOID:0050902","DOID:0060104","EFO:0002939","GARD:0007005","ICDO:9470/3","MEDGEN:7517","MESH:D008527","MedDRA:10027107","NANDO:2200090","NCIT:C3222","NORD:1422","OMIM:155255","ONCOTREE:MBL","Orphanet:616","SCTID:443333004","UMLS:C0025149","icd11.foundation:290815825"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":null,"is_group":false,"n_genes":6,"n_phenotypes":34,"mechanism_classes":[]},"genes":[{"id":"e_f9807409f67d","source":"MONDO:0007959","target":"BRCA2","type":"caused_by","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:155255","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://omim.org/entry/155255","snippet":"BRCA2 is annotated as disease gene of OMIM:155255 (HPO genes_to_phenotype, OMIM-derived)"}],"contradicting":[],"confidence":0.9,"independent_sources":["OMIM"],"level":"curated"},{"id":"e_f6705a016449","source":"MONDO:0007959","target":"CTNNB1","type":"caused_by","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:155255","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://omim.org/entr