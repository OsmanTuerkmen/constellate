{"node":{"id":"MONDO:0011053","label":"intellectual disability-sparse hair-brachydactyly syndrome","definition":"Intellectual disability-sparse hair-brachydactyly syndrome is a very rare condition of unknown etiology consisting of short stature, hypotrichosis, brachydactyly with cone-shaped epiphyses, epilepsy and severe mental delay. After the initial delineation of this syndrome by Nicolaides and Baraitser in 1993, only five more patients were published in the literature up to now.","synonyms":["NCBRS","NICOLAIDES-Baraitser syndrome","Nicolaides-Baraitser syndrome","SMARCA2-related BAFopathy","sparse hair and mental retardation"],"xrefs":["DOID:0081441","GARD:0000270","MEDGEN:220983","MESH:C536116","OMIM:601358","Orphanet:3051","SCTID:401046009","UMLS:C1303073"],"parents":[],"parents_labels":{},"children":[],"children_labels":{},"in_core":false,"cluster_id":1,"is_group":false,"n_genes":1,"n_phenotypes":105,"mechanism_classes":[]},"genes":[{"id":"e_ca61e055a109","source":"MONDO:0011053","target":"SMARCA2","type":"caused_by","evidence":[{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:3051","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/3051","confidence":0.95,"snippet":"Disease-causing germline mutation(s) in (Assessed) — SWI/SNF related BAF chromatin remodeling complex subunit ATPase 2"},{"db":"HPO","origin":"OMIM","record":"OMIM:601358","level":"curated","date":"2026-09-02","confidence":0.9,"url":"https://omim.org/entry/601358","snippet":"SMARCA2 is annotated as disease gene of OMIM:601358 (HPO genes_to_phenotype, OMIM-derived)"}],"contradicting":[],"confidence":0.95,"independent_sources":["OMIM","Orphanet"],"level":"curated"}],"phenotypes":[{"edge":{"id":"e_273d86d03cac","source":"MONDO:0011053","target":"HP:0006237","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:601358 · PMID:22366787;PMID:22822383","url":"https://pubmed.ncbi.nlm.nih.gov/22366787;PMID:22822383/","level":"observed","date":"