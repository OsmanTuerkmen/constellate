{"node":{"id":"HP:0002305","label":"Athetosis","ic":4.159,"definition":"A slow, continuous, involuntary writhing movement that prevents maintenance of a stable posture. Athetosis involves continuous smooth movements that appear random and are not composed of recognizable sub-movements or movement fragments. In contrast to chorea, in athetosis, the same regions of the body are repeatedly involved. Athetosis may worsen with attempts at movement of posture, but athetosis can also occur at rest."},"diseases":[{"id":"MONDO:0017222","label":"Pelizaeus-Merzbacher disease, classic form","in_core":true,"edge":{"id":"e_5fa4514b0c3e","source":"MONDO:0017222","target":"HP:0002305","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:280219 · ORPHA:280219","url":"https://www.orpha.net/en/disease/detail/280219","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Pelizaeus-Merzbacher disease, classic form: Athetosis (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:280219","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/280219","confidence":0.6,"snippet":"Athetosis — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0019366","label":"free sialic acid storage disease","in_core":true,"edge":{"id":"e_59193fda9802","source":"MONDO:0019366","target":"HP:0002305","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:834 · ORPHA:834","url":"https://www.orpha.net/en/disease/detail/834","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Free sialic acid storage disease: Athetosis (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:834","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/834","confidence":0.6,"snippet":"Athetosis — Frequent (79-30%)"}],"contradicting":[],"confiden