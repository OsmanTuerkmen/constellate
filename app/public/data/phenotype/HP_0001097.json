{"node":{"id":"HP:0001097","label":"Keratoconjunctivitis sicca","ic":5.437,"definition":"Dryness of the eye related to deficiency of the tear film components (aqueous, mucin, or lipid), lid surface abnormalities, or epithelial abnormalities. Keratoconjunctivitis sicca often results in a scratchy or sandy sensation (foreign body sensation) in the eyes, and may also be associated with itching, inability to produce tears, photosensitivity, redness, pain, and difficulty in moving the eyelids."},"diseases":[{"id":"MONDO:0010030","label":"Sjogren syndrome","in_core":false,"edge":{"id":"e_2c2bde099f64","source":"MONDO:0010030","target":"HP:0001097","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:270150 · PMID:36717930","url":"https://pubmed.ncbi.nlm.nih.gov/36717930/","level":"observed","date":"2025-11-19","confidence":0.77,"snippet":"Sjogren syndrome: Keratoconjunctivitis sicca (frequency 46/60) [PCS]"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:289390 · ORPHA:289390","url":"https://www.orpha.net/en/disease/detail/289390","level":"curated","date":"2026-09-02","confidence":0.9,"snippet":"Primary Sjögren disease: Keratoconjunctivitis sicca (frequency HP:0040281) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:289390","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/289390","confidence":0.9,"snippet":"Keratoconjunctivitis sicca — Very frequent (99-80%)"}],"contradicting":[],"confidence":0.9,"independent_sources":["OMIM","Orphanet"],"level":"observed"},"confidence":0.9},{"id":"MONDO:0005854","label":"mixed connective tissue disease","in_core":false,"edge":{"id":"e_3982722e6fef","source":"MONDO:0005854","target":"HP:0001097","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:809 · ORPHA:809","url":"https://www.orpha.net/en/disease/detail/809","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Mixed connective tissue disease: Keratoconjunctivitis si