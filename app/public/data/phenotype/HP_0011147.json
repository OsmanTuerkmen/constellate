{"node":{"id":"HP:0011147","label":"Typical absence seizure","ic":5.749,"definition":"A typical absence seizure is a type of generalized non-motor (absence) seizure characterized by its sudden onset, interruption of ongoing activities, a blank stare, possibly a brief upward deviation of the eyes. Usually the patient will be unresponsive when spoken to. Duration is a few seconds to half a minute with very rapid recovery. Although not always available, an EEG would usually show 3 Hz generalized epileptiform discharges during the event."},"diseases":[{"id":"MONDO:0980752","label":"leukoencephalopathy without lacunae, adult-onset","in_core":true,"edge":{"id":"e_51b63d03a2cc","source":"MONDO:0980752","target":"HP:0011147","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:621424 · PMID:34606115","url":"https://pubmed.ncbi.nlm.nih.gov/34606115/","level":"observed","date":"2025-12-18","confidence":1.0,"snippet":"Leukoencephalopathy without lacunae, adult-onset: Typical absence seizure (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0008045","label":"spinal muscular atrophy-progressive myoclonic epilepsy syndrome","in_core":true,"edge":{"id":"e_0a666350809b","source":"MONDO:0008045","target":"HP:0011147","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:2590 · ORPHA:2590","url":"https://www.orpha.net/en/disease/detail/2590","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Spinal muscular atrophy-progressive myoclonic epilepsy syndrome: Typical absence seizure (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:2590","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/2590","confidence":0.6,"snippet":"Typical absence seizure — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confi