{"node":{"id":"HP:0009193","label":"Metacarpal pseudoepiphysis","ic":7.516,"definition":"A pseudoepiphysis is a secondary ossification center distinct from the normal epiphysis. The normal metacarpal epiphyses are located at the distal ends of the metacarpal bones. Accessory epiphyses (which are also known as pseudoepiphyses) can also occasionally be observed at the proximal ends of the metacarpals, usually involving the 2nd metacarpal bone."},"diseases":[{"id":"MONDO:0010561","label":"Coffin-Lowry syndrome","in_core":false,"edge":{"id":"e_818c0d8fd80f","source":"MONDO:0010561","target":"HP:0009193","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:192 · ORPHA:192","url":"https://www.orpha.net/en/disease/detail/192","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Coffin-Lowry syndrome: Metacarpal pseudoepiphysis (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:192","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/192","confidence":0.6,"snippet":"Metacarpal pseudoepiphysis — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0008684","label":"Wolf-Hirschhorn syndrome","in_core":false,"edge":{"id":"e_6046b01c334c","source":"MONDO:0008684","target":"HP:0009193","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:194190 · OMIM:194190","url":"https://omim.org/entry/194190","level":"curated","date":"2009-02-17","confidence":0.5,"snippet":"Wolf-Hirschhorn syndrome: Metacarpal pseudoepiphysis [TAS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5}],"diseases_total":2,"diseases_contradicted":0}