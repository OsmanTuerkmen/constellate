{"node":{"id":"HP:0002548","label":"Parkinsonism with favorable response to dopaminergic medication","ic":6.061,"definition":"Parkinsonism is a clinical syndrome that is a feature of a number of different diseases, including Parkinson disease itself, other neurodegenerative diseases such as progressive supranuclear palsy, and as a side-effect of some neuroleptic medications. Some but not all individuals with Parkinsonism show responsiveness to dopaminergic medication defined as a substantial reduction of amelioration of the component signs of Parkinsonism (including mainly tremor, bradykinesia, rigidity, and postural instability) upon administration of dopaminergic medication."},"diseases":[{"id":"MONDO:0017809","label":"parkinsonism due to ATP13A2 deficiency","in_core":true,"edge":{"id":"e_1c7957396dbc","source":"MONDO:0017809","target":"HP:0002548","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:314632 · ORPHA:314632","url":"https://www.orpha.net/en/disease/detail/314632","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"CLN12 disease: Parkinsonism with favorable response to dopaminergic medication (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:314632","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/314632","confidence":0.6,"snippet":"Parkinsonism with favorable response to dopaminergic medication — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0009830","label":"parkinsonian-pyramidal syndrome","in_core":false,"edge":{"id":"e_5549d4c2e03a","source":"MONDO:0009830","target":"HP:0002548","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:260300 · PMID:18513678;PMID:25085748","url":"https://pubmed.ncbi.nlm.nih.gov/18513678;PMID:25085748/","level":"observed","date":"2022-11-26","confidence":1.0,"snippet":"Parkinson disease 1