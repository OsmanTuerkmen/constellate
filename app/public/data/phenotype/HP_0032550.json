{"node":{"id":"HP:0032550","label":"Howell-Jolly bodies","ic":7.671,"definition":"Howell-Jolly bodies are small, intra-erythrocytic remnants of erythrocyte nuclei. These inclusions are solitary in each erythrocyte and strongly basophilic. These are often confused with overlying platelets, but can be distinguished by the presence of a halo around overlying platelets."},"diseases":[{"id":"MONDO:0010524","label":"X-linked sideroblastic anemia with ataxia","in_core":false,"edge":{"id":"e_b16e4916a6d5","source":"MONDO:0010524","target":"HP:0032550","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:301310 · PMID:11118249","url":"https://pubmed.ncbi.nlm.nih.gov/11118249/","level":"observed","date":"2024-04-01","confidence":1.0,"snippet":"Anemia, sideroblastic, and spinocerebellar ataxia: Howell-Jolly bodies (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0013536","label":"heme oxygenase 1 deficiency","in_core":false,"edge":{"id":"e_d2cf85d2af81","source":"MONDO:0013536","target":"HP:0032550","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:562509 · ORPHA:562509","url":"https://www.orpha.net/en/disease/detail/562509","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Heme oxygenase-1 deficiency: Howell-Jolly bodies (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:562509","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/562509","confidence":0.3,"snippet":"Howell-Jolly bodies — Occasional (29-5%)"}],"contradicting":[],"confidence":0.3,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.3}],"diseases_total":2,"diseases_contradicted":0}