{"node":{"id":"HP:0001083","label":"Ectopia lentis","ic":5.303,"definition":"Dislocation or malposition of the crystalline lens of the eye. A partial displacement (or dislocation) of the lens is described as a subluxation of the lens, while a complete displacement is termed luxation of the lens. A complete displacement occurs if the lens is completely outside the patellar fossa of the lens, either in the anterior chamber, in the vitreous, or directly on the retina. If the lens is partially displaced but still contained within the lens space, then it is termed subluxation."},"diseases":[{"id":"MONDO:0009388","label":"hyperlysinemia","in_core":false,"edge":{"id":"e_f285ed5b9c7b","source":"MONDO:0009388","target":"HP:0001083","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:238700 · OMIM:238700","url":"https://omim.org/entry/238700","level":"curated","date":"2009-02-17","confidence":0.5,"snippet":"Hyperlysinemia, type I: Ectopia lentis [IEA]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0010075","label":"spondyloepimetaphyseal dysplasia with joint laxity, type 1, with or without fractures","in_core":false,"edge":{"id":"e_4cf3e5b7d136","source":"MONDO:0010075","target":"HP:0001083","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:271640 · OMIM:271640","url":"https://omim.org/entry/271640","level":"curated","date":"2013-08-11","confidence":0.5,"snippet":"Spondyloepimetaphyseal dysplasia with joint laxity, type 1, with or without fractures: Ectopia lentis [TAS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0010592","label":"focal dermal hypoplasia","in_core":false,"edge":{"id":"e_5925fbab1e5e","source":"MONDO:0010592","target":"HP:0001083","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:305600 · OMIM:305600","url":"https://omim.org/entry/30