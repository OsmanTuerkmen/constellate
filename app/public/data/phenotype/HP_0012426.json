{"node":{"id":"HP:0012426","label":"Optic disc drusen","ic":7.16,"definition":"Optic disc drusen are acellular, calcified deposits within the optic nerve head. Optic disc drusen are congenital and developmental anomalies of the optic nerve head, representing hyaline-containing bodies that, over time, appear as elevated, lumpy irregularities on the anterior portion of the optic nerve."},"diseases":[{"id":"MONDO:0009549","label":"severe early-childhood-onset retinal dystrophy","in_core":false,"edge":{"id":"e_e39279635206","source":"MONDO:0009549","target":"HP:0012426","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:364055 · ORPHA:364055","url":"https://www.orpha.net/en/disease/detail/364055","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Severe early-childhood-onset retinal dystrophy: Optic disc drusen (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:364055","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/364055","confidence":0.6,"snippet":"Optic disc drusen — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0019200","label":"retinitis pigmentosa","in_core":false,"edge":{"id":"e_27afdf69dcf6","source":"MONDO:0019200","target":"HP:0012426","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:791 · ORPHA:791","url":"https://www.orpha.net/en/disease/detail/791","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Retinitis pigmentosa: Optic disc drusen (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:791","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/791","confidence":0.6,"snippet":"Optic disc drusen — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6}],"diseases_t