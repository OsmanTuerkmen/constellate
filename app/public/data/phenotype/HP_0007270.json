{"node":{"id":"HP:0007270","label":"Atypical absence seizure","ic":5.825,"definition":"An atypical absence seizure is a type of generalized non-motor (absence) seizure characterized by interruption of ongoing activities and reduced responsiveness. In comparison to a typical absence seizure, changes in tone may be more pronounced, onset and/or cessation may be less abrupt, and the duration of the ictus and post-ictal recovery may be longer. Although not always available, an EEG often demonstrates slow (<3 Hz), irregular, generalized spike-wave activity."},"diseases":[{"id":"MONDO:0980969","label":"Charcot-Marie-Tooth disease, axonal, type 2LL","in_core":false,"edge":{"id":"e_abe517aff510","source":"MONDO:0980969","target":"HP:0007270","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:621485 · PMID:40814755","url":"https://pubmed.ncbi.nlm.nih.gov/40814755/","level":"observed","date":"2026-01-31","confidence":1.0,"snippet":"Charcot-Marie-Tooth disease, axonal, type 2LL: Atypical absence seizure (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0011794","label":"obsolete Dravet syndrome","in_core":false,"edge":{"id":"e_bf4c9a485c68","source":"MONDO:0011794","target":"HP:0007270","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:33069 · ORPHA:33069","url":"https://www.orpha.net/en/disease/detail/33069","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Dravet syndrome: Atypical absence seizure (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:33069","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/33069","confidence":0.6,"snippet":"Atypical absence seizure — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0016855","label":"Mowat-Wilson syndrome