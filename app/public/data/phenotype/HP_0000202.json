{"node":{"id":"HP:0000202","label":"Orofacial cleft","ic":2.588,"definition":"The presence of a cleft (gap, opening, or groove) in the oral cavity, including cleft of the upper lip and/or cleft of the palate. Cleft of the upper lip is visible as a groove or fissure in the lip, most frequently due to a congenital failure of the maxillary and median nasal processes to fuse. Cleft palate is characterized by a grooved depression or fissure in the roof of the mouth, most often resulting from a congenital failure of the palate to fuse properly. Clefts of the lip and palate can occur individually or together. It is preferable to code each defect separately."},"diseases":[{"id":"MONDO:0012997","label":"cholestasis-pigmentary retinopathy-cleft palate syndrome","in_core":false,"edge":{"id":"e_3546b3a73549","source":"MONDO:0012997","target":"HP:0000202","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:1415 · ORPHA:1415","url":"https://www.orpha.net/en/disease/detail/1415","level":"curated","date":"2026-09-02","confidence":0.9,"snippet":"Hardikar syndrome: Orofacial cleft (frequency HP:0040281) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:1415","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/1415","confidence":0.9,"snippet":"Orofacial cleft — Very frequent (99-80%)"}],"contradicting":[],"confidence":0.9,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.9},{"id":"MONDO:0008684","label":"Wolf-Hirschhorn syndrome","in_core":false,"edge":{"id":"e_140dfa03f9a0","source":"MONDO:0008684","target":"HP:0000202","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:194190 · http://www.ncbi.nlm.nih.gov/bookshelf/br.fcgi?book=gene&part=whs","url":"https://omim.org/entry/194190","level":"curated","date":"2009-02-17","confidence":0.6,"snippet":"Wolf-Hirschhorn syndrome: Orofacial cleft (frequency HP:0040282) [TAS]"}],"contradicting":[],"confidence":0.6,"independen