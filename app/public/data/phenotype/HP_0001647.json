{"node":{"id":"HP:0001647","label":"Bicuspid aortic valve","ic":4.528,"definition":"The presence of an aortic valve with two instead of the normal three cusps (flaps). Bicuspid aortic valvue is a malformation of a commissure (small space between the attachment of each cusp to the aortic wall) and the adjacent parts of the two corresponding cusps forming a raphe (the fused area of the two underdeveloped cusps turning into a malformed commissure between both cusps; the raphe is a fibrous ridge that extends from the commissure to the free edge of the two underdeveloped, conjoint cusps)."},"diseases":[{"id":"MONDO:0008436","label":"Sneddon syndrome","in_core":false,"edge":{"id":"e_639941a39f38","source":"MONDO:0008436","target":"HP:0001647","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:182410 · PMID:31652311","url":"https://pubmed.ncbi.nlm.nih.gov/31652311/","level":"observed","date":"2022-03-13","confidence":1.0,"snippet":"Sneddon syndrome: Bicuspid aortic valve (frequency 1/1) [PCS]"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:820 · ORPHA:820","url":"https://www.orpha.net/en/disease/detail/820","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Sneddon syndrome: Bicuspid aortic valve (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:820","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/820","confidence":0.3,"snippet":"Bicuspid aortic valve — Occasional (29-5%)"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM","Orphanet"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0014651","label":"acrofacial dysostosis Cincinnati type","in_core":false,"edge":{"id":"e_ac02f68a8f8e","source":"MONDO:0014651","target":"HP:0001647","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:616462 · PMID:37075751","url":"https://pubmed.ncbi.nlm.nih.gov/37075751/","level":"observed","date":"2024-04-01","confidence":1.0,"snippe