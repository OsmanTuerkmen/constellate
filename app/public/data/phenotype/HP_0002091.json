{"node":{"id":"HP:0002091","label":"Restrictive ventilatory defect","ic":4.771,"definition":"A functional defect characterized by reduced total lung capacity (TLC) not associated with abnormalities of expiratory airflow or airway resistance. Spirometrically, a restrictive defect is defined as FEV1 (forced expiratory volume in 1 second) and FVC (forced vital capacity) less than 80 per cent. Restrictive lung disease may be caused by alterations in lung parenchyma or because of a disease of the pleura, chest wall, or neuromuscular apparatus."},"diseases":[{"id":"MONDO:0009650","label":"mucolipidosis type II","in_core":true,"edge":{"id":"e_30bc1e007bec","source":"MONDO:0009650","target":"HP:0002091","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:576 · ORPHA:576","url":"https://www.orpha.net/en/disease/detail/576","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Mucolipidosis type II: Restrictive ventilatory defect (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:576","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/576","confidence":0.6,"snippet":"Restrictive ventilatory defect — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0009659","label":"mucopolysaccharidosis type 4A","in_core":true,"edge":{"id":"e_d1dd0c13c41b","source":"MONDO:0009659","target":"HP:0002091","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:253000 · OMIM:253000","url":"https://omim.org/entry/253000","level":"curated","date":"2009-02-17","confidence":0.5,"snippet":"Mucopolysaccharidosis IVA: Restrictive ventilatory defect [IEA]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0009660","label":"mucopolysaccharidosis type 4B","in_core":true,"edge":{"id":"e_04cfabfdf878","source":"MONDO:00