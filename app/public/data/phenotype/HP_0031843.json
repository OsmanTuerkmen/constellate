{"node":{"id":"HP:0031843","label":"Abnormally slow thought process","ic":7.516,"definition":"An inner sense from the self that thoughts are abnormally slow and the individual feels that they are unable to increase their rate of thinking. The primary pathology is the decreased rate and other qualities of thinking (e.g. naming of objects) are intact, just slowed. This may be associated with slowed speech, but may be internal and masked by speech that is limited to brief (yes or no) answers."},"diseases":[{"id":"MONDO:0007739","label":"Huntington disease","in_core":false,"edge":{"id":"e_d0c82eff9b05","source":"MONDO:0007739","target":"HP:0031843","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:399 · ORPHA:399","url":"https://www.orpha.net/en/disease/detail/399","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Huntington disease: Abnormally slow thought process (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:399","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/399","confidence":0.6,"snippet":"Abnormally slow thought process — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0010808","label":"fatal familial insomnia","in_core":false,"edge":{"id":"e_fbb938bb4db3","source":"MONDO:0010808","target":"HP:0031843","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:466 · ORPHA:466","url":"https://www.orpha.net/en/disease/detail/466","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Fatal familial insomnia: Abnormally slow thought process (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:466","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/466","confidence":0.6,"snippet":"Abnormally slow thought process — Frequent (79-30%)"}],"contradicting":[],"c