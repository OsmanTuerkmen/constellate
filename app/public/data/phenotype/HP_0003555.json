{"node":{"id":"HP:0003555","label":"Muscle fiber splitting","ic":6.166,"definition":"Fiber splitting or branching is a common finding in human and rat skeletal muscle pathology. Fiber splitting refers to longitudinal halving of the complete fiber, while branching originates from a regenerating end of a necrotic fiber as invaginations of the sarcolemma. In fiber branching, one end of the fiber remains intact as a single entity, while the other end has several branches."},"diseases":[{"id":"MONDO:0012215","label":"myofibrillar myopathy 3","in_core":false,"edge":{"id":"e_2a4ffa08dc77","source":"MONDO:0012215","target":"HP:0003555","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:609200 · PMID:10958653","url":"https://pubmed.ncbi.nlm.nih.gov/10958653/","level":"observed","date":"2024-02-15","confidence":1.0,"snippet":"Myopathy, myofibrillar, 3: Muscle fiber splitting (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0976133","label":"myopathy, myofibrillar, 13, with rimmed vacuoles","in_core":false,"edge":{"id":"e_cd595008ef6d","source":"MONDO:0976133","target":"HP:0003555","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:621078 · PMID:26718575;PMID:39548192;PMID:28501893","url":"https://pubmed.ncbi.nlm.nih.gov/26718575;PMID:39548192;PMID:28501893/","level":"observed","date":"2025-10-04","confidence":1.0,"snippet":"Myopathy, myofibrillar, 13, with rimmed vacuoles: Muscle fiber splitting (frequency 4/4) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0012130","label":"myofibrillar myopathy 2","in_core":false,"edge":{"id":"e_6c52d5466a98","source":"MONDO:0012130","target":"HP:0003555","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:608810 · OMIM:608810","url":"https://omim.org/entry/608810","level":"curated","date":"