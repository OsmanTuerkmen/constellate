{"node":{"id":"HP:0031179","label":"Nuchal rigidity","ic":6.823,"definition":"Resistance of the extensor muscles of the neck to being bent forwards (i.e., impaired neck flexion) as a result of muscle spasm of the extensor muscles of the neck. Nuchal rigidity is not a fixed rigidity. Nuchal rigidity has been used as a bedside test for meningism, although its sensitivity for this purpose has been debated."},"diseases":[{"id":"MONDO:0015342","label":"acute transverse myelitis","in_core":false,"edge":{"id":"e_2510ff0adc35","source":"MONDO:0015342","target":"HP:0031179","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:139417 · ORPHA:139417","url":"https://www.orpha.net/en/disease/detail/139417","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Acute transverse myelitis: Nuchal rigidity (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:139417","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/139417","confidence":0.3,"snippet":"Nuchal rigidity — Occasional (29-5%)"}],"contradicting":[],"confidence":0.3,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.3},{"id":"MONDO:0019036","label":"amoebiasis due to free-living amoebae","in_core":false,"edge":{"id":"e_98e258d754d6","source":"MONDO:0019036","target":"HP:0031179","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:68 · ORPHA:68","url":"https://www.orpha.net/en/disease/detail/68","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Amoebiasis due to free-living amoebae: Nuchal rigidity (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:68","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/68","confidence":0.3,"snippet":"Nuchal rigidity — Occasional (29-5%)"}],"contradicting":[],"confidence":0.3,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.3},{"id":"MOND