{"node":{"id":"HP:0001942","label":"Metabolic acidosis","ic":3.994,"definition":"Metabolic acidosis (MA) is characterized by a fall in blood pH due to a reduction of serum bicarbonate concentration. This can occur as a result of either the accumulation of acids (high anion gap MA) or the loss of bicarbonate from the gastrointestinal tract or the kidney (hyperchloremic MA). By definition, MA is not due to a respirary cause."},"diseases":[{"id":"MONDO:0014464","label":"progressive encephalopathy with leukodystrophy due to DECR deficiency","in_core":true,"edge":{"id":"e_b19973d12e65","source":"MONDO:0014464","target":"HP:0001942","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:616034 · PMID:24847004","url":"https://pubmed.ncbi.nlm.nih.gov/24847004/","level":"observed","date":"2023-02-19","confidence":1.0,"snippet":"2,4-dienoyl-CoA reductase deficiency: Metabolic acidosis (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0100151","label":"nephropathic cystinosis","in_core":true,"edge":{"id":"e_3052b9f4a967","source":"MONDO:0100151","target":"HP:0001942","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:219800 · PMID:35513889;PMID:24464559;PMID:31672123","url":"https://pubmed.ncbi.nlm.nih.gov/35513889;PMID:24464559;PMID:31672123/","level":"observed","date":"2024-03-16","confidence":0.61,"snippet":"Cystinosis, nephropathic: Metabolic acidosis (frequency 11/18) [PCS]"}],"contradicting":[],"confidence":0.61,"independent_sources":["OMIM"],"level":"observed"},"confidence":0.61},{"id":"MONDO:0016239","label":"cystinosis","in_core":true,"edge":{"id":"e_70f7a42284ed","source":"MONDO:0016239","target":"HP:0001942","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:213 · ORPHA:213","url":"https://www.orpha.net/en/disease/detail/213","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Cys