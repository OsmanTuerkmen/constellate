{"node":{"id":"HP:0000270","label":"Delayed cranial suture closure","ic":4.762,"definition":"Infants normally have two fontanels at birth, the diamond-shaped anterior fontanelle at the junction of the coronal and sagittal sutures, and the posterior fontanelle at the intersection of the occipital and parietal bones. The posterior fontanelle usually closes by the 8th week of life, and the anterior fontanel closes by the 18th month of life on average. This term applies if there is delay of closure of the fontanelles beyond the normal age."},"diseases":[{"id":"MONDO:0009940","label":"pycnodysostosis","in_core":true,"edge":{"id":"e_c7fcfbaa4865","source":"MONDO:0009940","target":"HP:0000270","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:763 · ORPHA:763","url":"https://www.orpha.net/en/disease/detail/763","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Pycnodysostosis: Delayed cranial suture closure (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:763","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/763","confidence":0.6,"snippet":"Delayed cranial suture closure — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0009402","label":"acrofrontofacionasal dysostosis 2","in_core":false,"edge":{"id":"e_fbea0f8550df","source":"MONDO:0009402","target":"HP:0000270","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:2211 · ORPHA:2211","url":"https://www.orpha.net/en/disease/detail/2211","level":"curated","date":"2026-09-02","confidence":0.9,"snippet":"Hypertelorism-hypospadias-polysyndactyly syndrome: Delayed cranial suture closure (frequency HP:0040281) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:2211","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/2211","confidence":0.9,"snippet"