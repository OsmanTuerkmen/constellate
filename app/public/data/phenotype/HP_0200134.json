{"node":{"id":"HP:0200134","label":"Epileptic encephalopathy","ic":4.557,"definition":"A condition in which epileptiform abnormalities are believed to contribute to the progressive disturbance in cerebral function. Epileptic encephalaopathy is characterized by (1) electrographic EEG paroxysmal activity that is often aggressive, (2) seizures that are usually multiform and intractable, (3) cognitive, behavioral and neurological deficits that may be relentless, and (4) sometimes early death."},"diseases":[{"id":"MONDO:0014593","label":"developmental and epileptic encephalopathy, 29","in_core":true,"edge":{"id":"e_65cdb9fc36b9","source":"MONDO:0014593","target":"HP:0200134","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:616339 · PMID:25817015","url":"https://pubmed.ncbi.nlm.nih.gov/25817015/","level":"curated","date":"2022-03-24","confidence":0.5,"snippet":"Epileptic encephalopathy, early infantile, 29: Epileptic encephalopathy [PCS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0010466","label":"multiple congenital anomalies-hypotonia-seizures syndrome 2","in_core":false,"edge":{"id":"e_97cea8da3b4d","source":"MONDO:0010466","target":"HP:0200134","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:300868 · PMID:24259184;PMID:22305531","url":"https://pubmed.ncbi.nlm.nih.gov/24259184;PMID:22305531/","level":"observed","date":"2022-08-13","confidence":1.0,"snippet":"Multiple congenital anomalies-hypotonia-seizures syndrome 2: Epileptic encephalopathy (frequency 11/11) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0010478","label":"SLC35A2-congenital disorder of glycosylation","in_core":false,"edge":{"id":"e_53ea293eaf25","source":"MONDO:0010478","target":"HP:0200134","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:300896 · PMID:241152