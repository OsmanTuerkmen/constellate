{"node":{"id":"HP:0005019","label":"Diaphyseal undertubulation","ic":6.371,"definition":"Tubulation refers to the size and shape of tubular bones. In children and adolescents, the modeling process regulates normal bone growth. Final shaft (tube) diameter depends on appositional bone growth and the equilibrium between periosteal and endosteal bone resorption and formation. Undertubulation refers to a broad, widened form of the shafts (diaphyses) of long bones."},"diseases":[{"id":"MONDO:0009662","label":"mucopolysaccharidosis type 7","in_core":true,"edge":{"id":"e_66cd62e61461","source":"MONDO:0009662","target":"HP:0005019","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:584 · ORPHA:584","url":"https://www.orpha.net/en/disease/detail/584","level":"curated","date":"2026-09-02","confidence":0.9,"snippet":"Mucopolysaccharidosis type 7: Diaphyseal undertubulation (frequency HP:0040281) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:584","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/584","confidence":0.9,"snippet":"Diaphyseal undertubulation — Very frequent (99-80%)"}],"contradicting":[],"confidence":0.9,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.9},{"id":"MONDO:0011758","label":"Hurler syndrome","in_core":true,"edge":{"id":"e_e161a4bb2003","source":"MONDO:0011758","target":"HP:0005019","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:607014 · OMIM:607014","url":"https://omim.org/entry/607014","level":"curated","date":"2012-08-04","confidence":0.5,"snippet":"Hurler syndrome: Diaphyseal undertubulation [TAS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0009595","label":"cartilage-hair hypoplasia","in_core":false,"edge":{"id":"e_4795d9453b3c","source":"MONDO:0009595","target":"HP:0005019","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","reco