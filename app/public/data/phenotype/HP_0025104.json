{"node":{"id":"HP:0025104","label":"Capillary malformation","ic":5.303,"definition":"A capillary malformation is a flat, sharply defined vascular stain of the skin. It may cover a large surface area or it may be scattered and appear as little islands of color. In a capillary maformation, the predominant vessels are small, slow-flow vessels (i.e., arterioles and postcapillary venules)."},"diseases":[{"id":"MONDO:0009735","label":"Netherton syndrome","in_core":false,"edge":{"id":"e_cd169085ed1a","source":"MONDO:0009735","target":"HP:0025104","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:256500 · PMID:31990481","url":"https://pubmed.ncbi.nlm.nih.gov/31990481/","level":"observed","date":"2025-11-03","confidence":1.0,"snippet":"Netherton syndrome: Capillary malformation (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0008318","label":"Proteus syndrome","in_core":false,"edge":{"id":"e_474d4f9b5a47","source":"MONDO:0008318","target":"HP:0025104","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:744 · ORPHA:744","url":"https://www.orpha.net/en/disease/detail/744","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Proteus syndrome: Capillary malformation (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:744","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/744","confidence":0.6,"snippet":"Capillary malformation — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0700325","label":"Parkes Weber syndrome","in_core":false,"edge":{"id":"e_d4d863a3c5d6","source":"MONDO:0700325","target":"HP:0025104","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:90307 · ORPHA:90307","url":"https://www.orpha.net/en/disease/detail/90