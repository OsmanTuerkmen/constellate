{"node":{"id":"HP:0045005","label":"Neural tube defect","ic":3.596,"definition":"A neural tube defect arises when the neural tube, the embryonic precursor of the brain and spinal cord, fails to close during neurulation. The cranial region (anencephaly) or the low spine (open spina bifida; myelomeningocele) are most commonly affected although, in the severe NTD craniorachischisis, almost the entire neural tube remains open, from midbrain to low spine."},"diseases":[{"id":"MONDO:0019757","label":"alobar holoprosencephaly","in_core":false,"edge":{"id":"e_965294208c06","source":"MONDO:0019757","target":"HP:0045005","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:93925 · ORPHA:93925","url":"https://www.orpha.net/en/disease/detail/93925","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Alobar holoprosencephaly: Neural tube defect (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:93925","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/93925","confidence":0.6,"snippet":"Neural tube defect — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0019756","label":"lobar holoprosencephaly","in_core":false,"edge":{"id":"e_68955c01d31e","source":"MONDO:0019756","target":"HP:0045005","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:93924 · ORPHA:93924","url":"https://www.orpha.net/en/disease/detail/93924","level":"curated","date":"2026-09-02","confidence":0.05,"snippet":"Lobar holoprosencephaly: Neural tube defect (frequency HP:0040284) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:93924","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/93924","confidence":0.05,"snippet":"Neural tube defect — Very rare (<4-1%)"}],"contradicting":[],"confidence":0.05,"independent_sources":["Orphanet"],"level"