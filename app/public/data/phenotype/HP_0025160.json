{"node":{"id":"HP:0025160","label":"Abnormal temper tantrums","ic":5.55,"definition":"Temper tantrums are brief episodes of extreme, unpleasant, and sometimes aggressive behaviors in response to frustration or anger, which are a normal part of development in toddlers. Temper tantrums that occur more frequently in a given time and/or are more severe in symptomatology and/or longer in duration and/or inappropriate for the given age compared to a temper tantrum that naturally occurs as a part of the developmental process are classified as abnormal temper tantrums."},"diseases":[{"id":"MONDO:0018937","label":"mucopolysaccharidosis type 3","in_core":true,"edge":{"id":"e_66cd487f2a69","source":"MONDO:0018937","target":"HP:0025160","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:581 · ORPHA:581","url":"https://www.orpha.net/en/disease/detail/581","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Mucopolysaccharidosis type 3: Abnormal temper tantrums (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:581","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/581","confidence":0.3,"snippet":"Abnormal temper tantrums — Occasional (29-5%)"}],"contradicting":[],"confidence":0.3,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.3},{"id":"MONDO:0009268","label":"Gaucher disease-ophthalmoplegia-cardiovascular calcification syndrome","in_core":true,"edge":{"id":"e_98678a0c0204","source":"MONDO:0009268","target":"HP:0025160","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:2072 · ORPHA:2072","url":"https://www.orpha.net/en/disease/detail/2072","level":"curated","date":"2026-09-02","confidence":0.05,"snippet":"Gaucher disease-ophthalmoplegia-cardiovascular calcification syndrome: Abnormal temper tantrums (frequency HP:0040284) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:2072","level":"curated","date":"