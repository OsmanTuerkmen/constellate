{"node":{"id":"HP:0000474","label":"Thickened nuchal skin fold","ic":5.55,"definition":"A thickening of the skin thickness in the posterior aspect of the fetal neck. A nuchal fold (NF) measurement is obtained in a transverse section of the fetal head at the level of the cavum septum pellucidum and thalami, angled posteriorly to include the cerebellum. The measurement is taken from the outer edge of the occiput bone to the outer skin limit directly in the midline. An NF measurement greater than 5 mm at 14 to 17+6 weeks of gestation, or 6 mm at 18 to 28 weeks has been associated with a markedly increased risk for Down syndrome."},"diseases":[{"id":"MONDO:0019609","label":"Zellweger spectrum disorders","in_core":true,"edge":{"id":"e_4df37b633ec5","source":"MONDO:0019609","target":"HP:0000474","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:912 · ORPHA:912","url":"https://www.orpha.net/en/disease/detail/912","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Zellweger syndrome: Thickened nuchal skin fold (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:912","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/912","confidence":0.3,"snippet":"Thickened nuchal skin fold — Occasional (29-5%)"}],"contradicting":[],"confidence":0.3,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.3},{"id":"MONDO:0007298","label":"spinocerebellar ataxia type 29","in_core":false,"edge":{"id":"e_72640acbb2be","source":"MONDO:0007298","target":"HP:0000474","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:117360 · PMID:25981959","url":"https://pubmed.ncbi.nlm.nih.gov/25981959/","level":"observed","date":"2024-07-17","confidence":1.0,"snippet":"Spinocerebellar ataxia 29, congenital nonprogressive: Thickened nuchal skin fold (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},