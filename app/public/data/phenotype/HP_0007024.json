{"node":{"id":"HP:0007024","label":"Pseudobulbar paralysis","ic":6.204,"definition":"Bilateral impairment of the function of the cranial nerves 9-12, which control musculature involved in eating, swallowing, and speech. Pseudobulbar paralysis is characterized clinically by dysarthria, dysphonia, and dysphagia with bifacial paralysis, and may be accompanied by Pseudobulbar behavioral symptoms such as enforced crying and laughing."},"diseases":[{"id":"MONDO:0008948","label":"cerebrotendinous xanthomatosis","in_core":true,"edge":{"id":"e_c41ec5961ae9","source":"MONDO:0008948","target":"HP:0007024","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:213700 · OMIM:213700","url":"https://omim.org/entry/213700","level":"curated","date":"2009-02-17","confidence":0.5,"snippet":"Cerebrotendinous xanthomatosis: Pseudobulbar paralysis [IEA]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0700295","label":"leukodystrophy, demyelinating, adult-onset, autosomal dominant, typical","in_core":true,"edge":{"id":"e_81531c1ca5c1","source":"MONDO:0700295","target":"HP:0007024","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:169500 · OMIM:169500","url":"https://omim.org/entry/169500","level":"curated","date":"2009-02-17","confidence":0.5,"snippet":"Leukodystrophy, adult-onset, autosomal dominant: Pseudobulbar paralysis [IEA]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0014506","label":"leukodystrophy, hypomyelinating, 9","in_core":true,"edge":{"id":"e_ae204f0e98b6","source":"MONDO:0014506","target":"HP:0007024","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:616140 · PMID:24777941","url":"https://pubmed.ncbi.nlm.nih.gov/24777941/","level":"observed","date":"2023-02-23","confidence":0.25,"snippet":"Leukodystrophy, hypomyelinating, 9: Pseudobulbar paralysis (fr