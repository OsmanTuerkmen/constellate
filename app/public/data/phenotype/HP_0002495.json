{"node":{"id":"HP:0002495","label":"Impaired vibratory sensation","ic":4.149,"definition":"A decrease in the ability to perceive vibration. Clinically, this is usually tested with a tuning fork which vibrates at 128 Hz and is applied to bony prominences such as the malleoli at the ankles or the metacarpal-phalangeal joints. There is a slow decay of vibration from the tuning fork. The degree of vibratory sense loss can be crudely estimated by counting the number of seconds that the examiner can perceive the vibration longer than the patient."},"diseases":[{"id":"MONDO:0013391","label":"sterol carrier protein 2 deficiency","in_core":true,"edge":{"id":"e_b82f99dc1a58","source":"MONDO:0013391","target":"HP:0002495","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:613724 · PMID:16685654","url":"https://pubmed.ncbi.nlm.nih.gov/16685654/","level":"observed","date":"2023-04-21","confidence":1.0,"snippet":"Leukoencephalopathy with dystonia and motor neuropathy: Impaired vibratory sensation (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0013937","label":"peroxisome biogenesis disorder 6B","in_core":true,"edge":{"id":"e_c239658d110a","source":"MONDO:0013937","target":"HP:0002495","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:614871 · PMID:20695019","url":"https://pubmed.ncbi.nlm.nih.gov/20695019/","level":"observed","date":"2022-11-01","confidence":0.5,"snippet":"Peroxisome biogenesis disorder 6B: Impaired vibratory sensation (frequency 1/2) [PCS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"observed"},"confidence":0.5},{"id":"MONDO:0008119","label":"spinocerebellar ataxia type 1","in_core":false,"edge":{"id":"e_17996030ebe4","source":"MONDO:0008119","target":"HP:0002495","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:164400 · OMIM:164400;PMID:14967775","url"