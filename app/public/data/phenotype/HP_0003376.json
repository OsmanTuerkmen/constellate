{"node":{"id":"HP:0003376","label":"Steppage gait","ic":4.974,"definition":"An abnormal gait pattern that arises from weakness of the pretibial and peroneal muscles due to a lower motor neuron lesion. Affected patients have footdrop and are unable to dorsiflex and evert the foot. The leg is lifted high on walking so that the toes clear the ground, and there may be a slapping noise when the foot strikes the ground again."},"diseases":[{"id":"MONDO:0009747","label":"mitochondrial DNA depletion syndrome 6 (hepatocerebral type)","in_core":false,"edge":{"id":"e_86e17415bdc3","source":"MONDO:0009747","target":"HP:0003376","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:256810 · PMID:24190800","url":"https://pubmed.ncbi.nlm.nih.gov/24190800/","level":"observed","date":"2024-10-26","confidence":1.0,"snippet":"Mitochondrial DNA depletion syndrome 6 (hepatocerebral type): Steppage gait (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0011451","label":"cardioencephalomyopathy, fatal infantile, due to cytochrome c oxidase deficiency 1","in_core":false,"edge":{"id":"e_435037996a42","source":"MONDO:0011451","target":"HP:0003376","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:604377 · PMID:29351582","url":"https://pubmed.ncbi.nlm.nih.gov/29351582/","level":"observed","date":"2024-10-31","confidence":1.0,"snippet":"Mitochondrial complex IV deficiency, nuclear type 2: Steppage gait (frequency 2/2) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0011801","label":"spinocerebellar ataxia, autosomal recessive, with axonal neuropathy 1","in_core":false,"edge":{"id":"e_484640a312ad","source":"MONDO:0011801","target":"HP:0003376","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:607250 · PMID:12244316","url":"https://pubmed.ncbi.nlm