{"node":{"id":"HP:0000618","label":"Blindness","ic":4.149,"definition":"Blindness is the condition of lacking visual perception defined as a profound reduction in visual perception. On the 6m visual acuity scale, blindness is defined as less than 3/60. On the 20ft visual acuity scale, blindness is defined as less than 20/400. On the decimal visual acuity scale, blindness is defined as less than 0.05. Blindness is typically characterized by a visual field of no greater than 10 degrees in radius around central fixation."},"diseases":[{"id":"MONDO:0100151","label":"nephropathic cystinosis","in_core":true,"edge":{"id":"e_8d45a892e45c","source":"MONDO:0100151","target":"HP:0000618","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:219800 · PMID:11116719","url":"https://pubmed.ncbi.nlm.nih.gov/11116719/","level":"observed","date":"2024-03-16","confidence":1.0,"snippet":"Cystinosis, nephropathic: Blindness (frequency 1/1) [PCS]"}],"contradicting":[{"db":"HPO","origin":"OMIM","record":"OMIM:219800 · PMID:20803298","url":"https://pubmed.ncbi.nlm.nih.gov/20803298/","level":"observed","date":"2024-03-16","confidence":0.0,"snippet":"Cystinosis, nephropathic: Blindness (frequency 0/23) [PCS]"}],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0009260","label":"GM1 gangliosidosis type 1","in_core":true,"edge":{"id":"e_e553dd5ab31a","source":"MONDO:0009260","target":"HP:0000618","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:79255 · ORPHA:79255","url":"https://www.orpha.net/en/disease/detail/79255","level":"curated","date":"2026-09-02","confidence":0.9,"snippet":"GM1 gangliosidosis type 1: Blindness (frequency HP:0040281) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:79255","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/79255","confidence":0.9,"snippet":"Blindness — Very frequent (99-80%)"}],"contradicting":[],"confi