{"node":{"id":"HP:0012671","label":"Abulia","ic":8.076,"definition":"Abulia is characterized by difficulty in initiating and sustaining spontaneous movements; the person often appears frozen but will move hesitantly on request. There are frequently substantial reductions in emotional responsiveness, spontaneous speech, and social interaction. The individual appears to be content to remain still and inactive with minimal movement, but moves or reacts hesitantly in response to interactions."},"diseases":[{"id":"MONDO:0000914","label":"cerebral arteriopathy, autosomal dominant, with subcortical infarcts and leukoencephalopathy, type 1","in_core":false,"edge":{"id":"e_deec0c0d1cac","source":"MONDO:0000914","target":"HP:0012671","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:125310 · PMID:10371078","url":"https://pubmed.ncbi.nlm.nih.gov/10371078/","level":"observed","date":"2022-04-24","confidence":1.0,"snippet":"Cerebral arteriopathy, autosomal dominant, with subcortical infarctsand leukoencephalopathy: Abulia (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0010857","label":"semantic dementia","in_core":false,"edge":{"id":"e_39436ed0bd1b","source":"MONDO:0010857","target":"HP:0012671","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:100069 · ORPHA:100069","url":"https://www.orpha.net/en/disease/detail/100069","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Semantic dementia: Abulia (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:100069","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/100069","confidence":0.6,"snippet":"Abulia — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0010829","label":"cerebral arteriopathy, autosomal recess