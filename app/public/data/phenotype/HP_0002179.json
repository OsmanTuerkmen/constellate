{"node":{"id":"HP:0002179","label":"Opisthotonus","ic":5.186,"definition":"Opisthotonus is defined as a dramatic abnormal posture due to spastic contraction of the extensor muscles of the neck, trunk, and lower extremities that produces a severe backward arching from neck to heel. In most cases, the trunk is elevated off the ground by a few inches. It is usually sudden in onset and can be sustained or repetitive. It can be considered a variant of decerebrate posturing involving a hyperextension of the neck, back, and limbs."},"diseases":[{"id":"MONDO:0009266","label":"Gaucher disease type II","in_core":true,"edge":{"id":"e_1958f336d8c3","source":"MONDO:0009266","target":"HP:0002179","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:77260 · ORPHA:77260","url":"https://www.orpha.net/en/disease/detail/77260","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Gaucher disease type 2: Opisthotonus (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:77260","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/77260","confidence":0.6,"snippet":"Opisthotonus — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0010079","label":"Canavan disease","in_core":true,"edge":{"id":"e_37e6c6f85191","source":"MONDO:0010079","target":"HP:0002179","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:271900 · OMIM:264470","url":"https://omim.org/entry/271900","level":"curated","date":"2012-04-11","confidence":0.5,"snippet":"Canavan disease: Opisthotonus [PCS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0011945","label":"Gaucher disease perinatal lethal","in_core":true,"edge":{"id":"e_27d8ff916288","source":"MONDO:0011945","target":"HP:0002179","type":"has_phenotype","evidence":[{"db":"HPO","