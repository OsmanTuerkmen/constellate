{"node":{"id":"HP:0033051","label":"Impaired executive functioning","ic":6.572,"definition":"A disturbance of executive functioning, which is broadly defined as the set of abilities that allow for the planning, executing, monitoring, and self-correcting of goal-directed behavior while inhibiting task-irrelevant behavior. At least some degree of executive skill is needed to complete most cognitive tasks, and deficits in executive abilities are central to many clinical conditions, including fronto-temporal dementia."},"diseases":[{"id":"MONDO:0800027","label":"leukoencephalopathy, diffuse hereditary, with spheroids 1","in_core":true,"edge":{"id":"e_bed20f32573a","source":"MONDO:0800027","target":"HP:0033051","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:221820 · PMID:27423618","url":"https://pubmed.ncbi.nlm.nih.gov/27423618/","level":"observed","date":"2022-04-03","confidence":1.0,"snippet":"Leukoencephalopathy, diffuse hereditary, with spheroids: Impaired executive functioning (frequency 3/3) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0980752","label":"leukoencephalopathy without lacunae, adult-onset","in_core":true,"edge":{"id":"e_3d9e458e64f7","source":"MONDO:0980752","target":"HP:0033051","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:621424 · PMID:34606115;PMID:37063705","url":"https://pubmed.ncbi.nlm.nih.gov/34606115;PMID:37063705/","level":"observed","date":"2025-12-18","confidence":1.0,"snippet":"Leukoencephalopathy without lacunae, adult-onset: Impaired executive functioning (frequency 3/3) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0011803","label":"hereditary spastic paraplegia 7","in_core":false,"edge":{"id":"e_1170acf44113","source":"MONDO:0011803","target":"HP:0033051","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OM