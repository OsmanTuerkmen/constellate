{"node":{"id":"HP:0002121","label":"Generalized non-motor (absence) seizure","ic":4.12,"definition":"A generalized non-motor (absence) seizure is a type of a type of dialeptic seizure that is of electrographically generalized onset. It is a generalized seizure characterized by an interruption of activities, a blank stare, and usually the person will be unresponsive when spoken to. Any ictal motor phenomena are minor in comparison to these non-motor features."},"diseases":[{"id":"MONDO:0011871","label":"Niemann-Pick disease type B","in_core":true,"edge":{"id":"e_a25f03ba97d6","source":"MONDO:0011871","target":"HP:0002121","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:77293 · ORPHA:77293","url":"https://www.orpha.net/en/disease/detail/77293","level":"curated","date":"2026-09-02","confidence":0.05,"snippet":"Chronic visceral acid sphingomyelinase deficiency: Generalized non-motor (absence) seizure (frequency HP:0040284) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:77293","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/77293","confidence":0.05,"snippet":"Generalized non-motor (absence) seizure — Very rare (<4-1%)"}],"contradicting":[],"confidence":0.05,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.05},{"id":"MONDO:0978301","label":"neurodevelopmental disorder with dysmorphic facies, brain anomalies, and seizures","in_core":false,"edge":{"id":"e_527aae4f94b2","source":"MONDO:0978301","target":"HP:0002121","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:621201 · PMID:39636576","url":"https://pubmed.ncbi.nlm.nih.gov/39636576/","level":"observed","date":"2025-12-24","confidence":1.0,"snippet":"Neurodevelopmental disorder with dysmorphic facies, brain anomalies, and seizures: Generalized non-motor (absence) seizure (frequency 3/3) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confiden