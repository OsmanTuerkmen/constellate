{"node":{"id":"HP:0011931","label":"Abnormal cerebellar peduncle morphology","ic":6.69,"definition":"An anomaly of the cerebellar peduncles. The superior, middle, and inferior cerebellar peduncles emerge from the cerebellum. The superior cerebellar penduncles connect the cerebellum to the midbrain, the middle cerebellar peduncles connect the cerebellum to the pons, and the inferior cerebellar peduncle connects the medulla spinalis and medulla oblongata with the cerebellum."},"diseases":[{"id":"MONDO:0979226","label":"leukodystrophy, adult-onset, autosomal dominant, without amyloid angiopathy","in_core":true,"edge":{"id":"e_42964f46b200","source":"MONDO:0979226","target":"HP:0011931","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:621214 · PMID:38489591","url":"https://pubmed.ncbi.nlm.nih.gov/38489591/","level":"observed","date":"2026-01-06","confidence":0.93,"snippet":"Leukodystrophy, adult-onset, autosomal dominant, without amyloid angiopathy: Abnormal cerebellar peduncle morphology (frequency 14/15) [PCS]"}],"contradicting":[],"confidence":0.93,"independent_sources":["OMIM"],"level":"observed"},"confidence":0.93},{"id":"MONDO:0008215","label":"adult-onset autosomal dominant demyelinating leukodystrophy","in_core":true,"edge":{"id":"e_a08049002ace","source":"MONDO:0008215","target":"HP:0011931","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:99027 · ORPHA:99027","url":"https://www.orpha.net/en/disease/detail/99027","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Adult-onset autosomal dominant leukodystrophy: Abnormal cerebellar peduncle morphology (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:99027","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/99027","confidence":0.6,"snippet":"Abnormal cerebellar peduncle morphology — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet