{"node":{"id":"HP:0012452","label":"Restless legs","ic":6.754,"definition":"An irresistible urge to move the legs, usually accompanied by unpleasant sensations deep within the limbs. Symptoms typically begin or worsen during periods of rest or inactivity, are most pronounced in the evening or at night, and are temporarily relieved by movement such as walking or stretching. The disturbance often interferes with the initiation or maintenance of sleep."},"diseases":[{"id":"MONDO:0016163","label":"spinocerebellar ataxia 7","in_core":false,"edge":{"id":"e_a328e49b4e9b","source":"MONDO:0016163","target":"HP:0012452","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:94147 · ORPHA:94147","url":"https://www.orpha.net/en/disease/detail/94147","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Spinocerebellar ataxia type 7: Restless legs (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:94147","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/94147","confidence":0.6,"snippet":"Restless legs — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0100339","label":"Friedreich ataxia","in_core":false,"edge":{"id":"e_e229b541493f","source":"MONDO:0100339","target":"HP:0012452","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:95 · ORPHA:95","url":"https://www.orpha.net/en/disease/detail/95","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Friedreich ataxia: Restless legs (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:95","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/95","confidence":0.6,"snippet":"Restless legs — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:001