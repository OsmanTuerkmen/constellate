{"node":{"id":"HP:0001982","label":"Sea-blue histiocytosis","ic":7.671,"definition":"An abnormality of histiocytes, in which the cells take on a sea blue appearance due to abnormally increased lipid content. Histiocytes are a type of macrophage. Sea-blue histiocytes are typically large macrophages from 20 to 60 micrometers in diameter with a single eccentric nucleus whose cytoplasm if packed with sea-blue or blue-green granules when stained with Wright-Giemsa."},"diseases":[{"id":"MONDO:0009757","label":"Niemann-Pick disease, type C1","in_core":true,"edge":{"id":"e_3f6bbc563812","source":"MONDO:0009757","target":"HP:0001982","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:257220 · PMID:12408188","url":"https://pubmed.ncbi.nlm.nih.gov/12408188/","level":"observed","date":"2021-09-24","confidence":1.0,"snippet":"Niemann-pick disease, type C1: Sea-blue histiocytosis (frequency 4/4) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0010017","label":"sea-blue histiocyte syndrome","in_core":true,"edge":{"id":"e_2f319bae1419","source":"MONDO:0010017","target":"HP:0001982","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:269600 · PMID:11095479","url":"https://pubmed.ncbi.nlm.nih.gov/11095479/","level":"observed","date":"2022-05-28","confidence":1.0,"snippet":"Sea-Blue histiocyte disease: Sea-blue histiocytosis (frequency 2/2) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0009261","label":"GM1 gangliosidosis type 2","in_core":true,"edge":{"id":"e_5547cf2f19f5","source":"MONDO:0009261","target":"HP:0001982","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:230600 · OMIM:230600","url":"https://omim.org/entry/230600","level":"curated","date":"2009-02-17","confidence":0.5,"snippet":"GM1-gangliosidosis, type II: Sea-blue histiocytosis [IEA