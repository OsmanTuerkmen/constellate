{"node":{"id":"HP:0002454","label":"Eye of the tiger anomaly of globus pallidus","ic":6.977,"definition":"The presence, on T2-weighted magnetic resonance imaging, of markedly low signal intensity of the globus pallidus that surrounds a central region of high signal intensity in the anteromedial globus pallidus, producing an eye-of-the-tiger appearance. The sign is thought to represent iron accumulation in the globus pallidus."},"diseases":[{"id":"MONDO:0009319","label":"pantothenate kinase-associated neurodegeneration","in_core":false,"edge":{"id":"e_71790358781c","source":"MONDO:0009319","target":"HP:0002454","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:234200 · PMID:28821231;PMID:15911822","url":"https://pubmed.ncbi.nlm.nih.gov/28821231;PMID:15911822/","level":"observed","date":"2022-03-14","confidence":1.0,"snippet":"Neurodegeneration with brain iron accumulation 1: Eye of the tiger anomaly of globus pallidus (frequency 15/15) [PCS]"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:157850 · ORPHA:157850","url":"https://www.orpha.net/en/disease/detail/157850","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Pantothenate kinase-associated neurodegeneration: Eye of the tiger anomaly of globus pallidus (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:157850","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/157850","confidence":0.6,"snippet":"Eye of the tiger anomaly of globus pallidus — Frequent (79-30%)"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM","Orphanet"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0009502","label":"pyruvate dehydrogenase E2 deficiency","in_core":false,"edge":{"id":"e_ff241a3c4336","source":"MONDO:0009502","target":"HP:0002454","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:79244 · ORPHA:79244","url":"https://www.orpha.net/en/disease/detail/79244","level":"cura