{"node":{"id":"HP:0100814","label":"Blue nevus","ic":7.265,"definition":"A solitary, bluish, smooth surfaced macule, papule or plaque that is generally round or oval in shape. The histopathology of blue nevi varies by subtype, but general characteristics include a vertical wedge or bulbous shaped proliferation of spindle cells, dendritic melanocytes, and melanophages into a sclerotic dermis or subcutis."},"diseases":[{"id":"MONDO:0017721","label":"Sandhoff disease, infantile form","in_core":true,"edge":{"id":"e_a44783ebaea4","source":"MONDO:0017721","target":"HP:0100814","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:309155 · ORPHA:309155","url":"https://www.orpha.net/en/disease/detail/309155","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Sandhoff disease, infantile form: Blue nevus (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:309155","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/309155","confidence":0.3,"snippet":"Blue nevus — Occasional (29-5%)"}],"contradicting":[],"confidence":0.3,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.3},{"id":"MONDO:0859273","label":"liver disease, severe congenital","in_core":false,"edge":{"id":"e_ee9fe6a385f6","source":"MONDO:0859273","target":"HP:0100814","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:619991 · PMID:35864190","url":"https://pubmed.ncbi.nlm.nih.gov/35864190/","level":"observed","date":"2022-08-28","confidence":0.07,"snippet":"Liver disease, severe congenital: Blue nevus (frequency 1/14) [PCS]"}],"contradicting":[],"confidence":0.07,"independent_sources":["OMIM"],"level":"observed"},"confidence":0.07}],"diseases_total":2,"diseases_contradicted":0}