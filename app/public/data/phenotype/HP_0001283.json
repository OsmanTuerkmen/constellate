{"node":{"id":"HP:0001283","label":"Bulbar palsy","ic":5.57,"definition":"Bulbar weakness (or bulbar palsy) refers to bilateral impairment of function of the lower cranial nerves IX, X, XI and XII, which occurs due to lower motor neuron lesion either at nuclear or fascicular level in the medulla or from bilateral lesions of the lower cranial nerves outside the brain-stem. Bulbar weakness is often associated with difficulty in chewing, weakness of the facial muscles, dysarthria, palatal weakness and regurgitation of fluids, dysphagia, and dysphonia."},"diseases":[{"id":"MONDO:0009591","label":"metachromatic leukodystrophy, juvenile form","in_core":true,"edge":{"id":"e_6e9e5ca69e18","source":"MONDO:0009591","target":"HP:0001283","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:250100 · OMIM:250100","url":"https://omim.org/entry/250100","level":"curated","date":"2009-02-17","confidence":0.5,"snippet":"Metachromatic leukodystrophy: Bulbar palsy [IEA]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0018544","label":"adrenoleukodystrophy","in_core":true,"edge":{"id":"e_3848fb9e61db","source":"MONDO:0018544","target":"HP:0001283","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:300100 · OMIM:300100","url":"https://omim.org/entry/300100","level":"curated","date":"2013-06-23","confidence":0.5,"snippet":"Adrenoleukodystrophy: Bulbar palsy [TAS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0008119","label":"spinocerebellar ataxia type 1","in_core":false,"edge":{"id":"e_83d95341d4b3","source":"MONDO:0008119","target":"HP:0001283","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:164400 · OMIM:164400","url":"https://omim.org/entry/164400","level":"curated","date":"2009-02-17","confidence":0.5,"snippet":"Spinocerebellar ataxia 1: Bulbar palsy [IEA]"}]