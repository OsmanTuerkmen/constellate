{"node":{"id":"HP:0100753","label":"Schizophrenia","ic":5.473,"definition":"A mental disorder characterized by a disintegration of thought processes and emotional responsiveness. It most commonly manifests as auditory hallucinations, paranoid or bizarre delusions, or disorganized speech and thinking. It is accompanied by significant social or occupational dysfunction. The onset of symptoms typically occurs in young adulthood, with a global lifetime prevalence of about 1%. This term is not a helpful parent term to describe abnormal experiences."},"diseases":[{"id":"MONDO:0017730","label":"metachromatic leukodystrophy, adult form","in_core":true,"edge":{"id":"e_82621d516cd5","source":"MONDO:0017730","target":"HP:0100753","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:309271 · ORPHA:309271","url":"https://www.orpha.net/en/disease/detail/309271","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Metachromatic leukodystrophy, adult form: Schizophrenia (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:309271","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/309271","confidence":0.3,"snippet":"Schizophrenia — Occasional (29-5%)"}],"contradicting":[],"confidence":0.3,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.3},{"id":"MONDO:0018868","label":"metachromatic leukodystrophy","in_core":true,"edge":{"id":"e_834642b8a4e0","source":"MONDO:0018868","target":"HP:0100753","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:512 · ORPHA:512","url":"https://www.orpha.net/en/disease/detail/512","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Metachromatic leukodystrophy: Schizophrenia (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:512","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/512","confidence":0.3,"snippet":"Schizop