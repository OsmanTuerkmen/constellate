{"node":{"id":"HP:0009886","label":"Trichorrhexis nodosa","ic":6.371,"definition":"Trichorrhexis nodosa is the formation of nodes along the hair shaft through which breakage readily occurs. It is thus a focal defect in the hair fiber that is characterized by thickening or weak points (nodes) that cause the hair to break off easily. The result is defective, abnormally fragile hair."},"diseases":[{"id":"MONDO:0030517","label":"trichothiodystrophy 8, nonphotosensitive","in_core":true,"edge":{"id":"e_2455c61399c5","source":"MONDO:0030517","target":"HP:0009886","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:619691 · PMID:33909043","url":"https://pubmed.ncbi.nlm.nih.gov/33909043/","level":"observed","date":"2022-03-25","confidence":0.5,"snippet":"Trichothiodystrophy 8, nonphotosensitive: Trichorrhexis nodosa (frequency 1/2) [PCS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"observed"},"confidence":0.5},{"id":"MONDO:0009735","label":"Netherton syndrome","in_core":false,"edge":{"id":"e_21a4af787c69","source":"MONDO:0009735","target":"HP:0009886","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:256500 · PMID:24506793;PMID:22089833","url":"https://pubmed.ncbi.nlm.nih.gov/24506793;PMID:22089833/","level":"observed","date":"2025-11-03","confidence":0.23,"snippet":"Netherton syndrome: Trichorrhexis nodosa (frequency 3/13) [PCS]"},{"db":"HPO","origin":"Orphanet","record":"ORPHA:634 · ORPHA:634","url":"https://www.orpha.net/en/disease/detail/634","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Netherton syndrome: Trichorrhexis nodosa (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:634","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/634","confidence":0.6,"snippet":"Trichorrhexis nodosa — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["OMIM","Orphanet"],"level":"obser