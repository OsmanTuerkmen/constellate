{"node":{"id":"HP:0006989","label":"Dysplastic corpus callosum","ic":5.612,"definition":"Dysplasia and dysgenesis of the corpus callosum are nonspecific descriptions that imply defective development of the corpus callosum. The term dysplasia is applied when the morphology of the corpus callosum is altered as a congenital trait. For instance, the corpus callosum may be hump-shaped, kinked, or a striped corpus callosum that lacks an anatomically distinct genu and splenium."},"diseases":[{"id":"MONDO:0009653","label":"mucolipidosis type IV","in_core":true,"edge":{"id":"e_8e6ee0fc57ee","source":"MONDO:0009653","target":"HP:0006989","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:252650 · PMID:21763169","url":"https://pubmed.ncbi.nlm.nih.gov/21763169/","level":"curated","date":"2019-03-01","confidence":0.5,"snippet":"Mucolipidosis IV: Dysplastic corpus callosum [PCS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:0013971","label":"leukoencephalopathy-thalamus and brainstem anomalies-high lactate syndrome","in_core":true,"edge":{"id":"e_f039912cfed7","source":"MONDO:0013971","target":"HP:0006989","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:614924 · OMIM:614924","url":"https://omim.org/entry/614924","level":"curated","date":"2012-11-20","confidence":0.5,"snippet":"Combined oxidative phosphorylation deficiency 12: Dysplastic corpus callosum [TAS]"}],"contradicting":[],"confidence":0.5,"independent_sources":["OMIM"],"level":"curated"},"confidence":0.5},{"id":"MONDO:1060179","label":"RNU5B-1 related neurodevelopmental disorder with seizures and joint laxity","in_core":false,"edge":{"id":"e_9c9729e837d4","source":"MONDO:1060179","target":"HP:0006989","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:621302 · PMID:40379786;PMID:40442284","url":"https://pubmed.ncbi.nlm.nih.gov/40379786;PMID:40442284/","level":"observ