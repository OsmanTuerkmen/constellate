{"node":{"id":"HP:0007301","label":"Oromotor apraxia","ic":6.897,"definition":"Oral-motor apraxia is the inability to volitionally sequence oral movements of the speech structure for nonspeech tasks in the absence of neuromuscular deficits such as paralysis or muscle weakness. Oral-motor apraxia is diagnosed when, despite intact sensory motor function an individual is unable to use these effector systems under voluntary control."},"diseases":[{"id":"MONDO:0014732","label":"leukodystrophy, hypomyelinating, 12","in_core":true,"edge":{"id":"e_215dad879fa3","source":"MONDO:0014732","target":"HP:0007301","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:466934 · ORPHA:466934","url":"https://www.orpha.net/en/disease/detail/466934","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"VPS11-related autosomal recessive hypomyelinating leukodystrophy: Oromotor apraxia (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:466934","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/466934","confidence":0.6,"snippet":"Oromotor apraxia — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0019757","label":"alobar holoprosencephaly","in_core":false,"edge":{"id":"e_d39a110050b1","source":"MONDO:0019757","target":"HP:0007301","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:93925 · ORPHA:93925","url":"https://www.orpha.net/en/disease/detail/93925","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Alobar holoprosencephaly: Oromotor apraxia (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:93925","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/93925","confidence":0.6,"snippet":"Oromotor apraxia — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sourc