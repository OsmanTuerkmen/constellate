{"node":{"id":"HP:0011097","label":"Epileptic spasm","ic":4.042,"definition":"A sudden flexion, extension, or mixed extension-flexion of predominantly proximal and truncal muscles that is usually more sustained than a myoclonic movement but not as sustained as a tonic seizure. Limited forms may occur: Grimacing, head nodding, or subtle eye movements. Epileptic spasms frequently occur in clusters. Infantile spasms are the best known form, but spasms can occur at all ages"},"diseases":[{"id":"MONDO:0010079","label":"Canavan disease","in_core":true,"edge":{"id":"e_ec0d282cc3ed","source":"MONDO:0010079","target":"HP:0011097","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:271900 · PMID:34446995","url":"https://pubmed.ncbi.nlm.nih.gov/34446995/","level":"observed","date":"2022-04-30","confidence":0.08,"snippet":"Canavan disease: Epileptic spasm (frequency 1/12) [PCS]"}],"contradicting":[],"confidence":0.08,"independent_sources":["OMIM"],"level":"observed"},"confidence":0.08},{"id":"MONDO:0010478","label":"SLC35A2-congenital disorder of glycosylation","in_core":false,"edge":{"id":"e_2a54900f2f26","source":"MONDO:0010478","target":"HP:0011097","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:300896 · PMID:24115232","url":"https://pubmed.ncbi.nlm.nih.gov/24115232/","level":"observed","date":"2021-06-15","confidence":1.0,"snippet":"Congenital disorder of glycosylation, type IIm: Epileptic spasm (frequency 3/3) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0011053","label":"intellectual disability-sparse hair-brachydactyly syndrome","in_core":false,"edge":{"id":"e_2710517611f3","source":"MONDO:0011053","target":"HP:0011097","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:3051 · ORPHA:3051","url":"https://www.orpha.net/en/disease/detail/3051","level":"curated","date":"2026-09-02","confidence":0.6,"snippet