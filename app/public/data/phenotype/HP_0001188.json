{"node":{"id":"HP:0001188","label":"Hand clenching","ic":5.773,"definition":"An abnormal hand posture in which the hands are clenched to fists. All digits held completely flexed at the metacarpophalangeal and interphalangeal joints. In prenatal sonography of the fetal clenched hand, the index finger overlaps a clenched fist formed by the other digits. The proximal interphalangeal articulation of the index finger is flexed and ulnarly deviated, and the thumb is adducted."},"diseases":[{"id":"MONDO:0016089","label":"infantile Krabbe disease","in_core":true,"edge":{"id":"e_aa1ac42f4a86","source":"MONDO:0016089","target":"HP:0001188","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:206436 · ORPHA:206436","url":"https://www.orpha.net/en/disease/detail/206436","level":"curated","date":"2026-09-02","confidence":0.6,"snippet":"Infantile Krabbe disease: Hand clenching (frequency HP:0040282) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:206436","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/206436","confidence":0.6,"snippet":"Hand clenching — Frequent (79-30%)"}],"contradicting":[],"confidence":0.6,"independent_sources":["Orphanet"],"level":"curated"},"confidence":0.6},{"id":"MONDO:0009499","label":"Krabbe disease","in_core":true,"edge":{"id":"e_fa4d37aa6a1d","source":"MONDO:0009499","target":"HP:0001188","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:487 · ORPHA:487","url":"https://www.orpha.net/en/disease/detail/487","level":"curated","date":"2026-09-02","confidence":0.3,"snippet":"Krabbe disease: Hand clenching (frequency HP:0040283) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:487","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/487","confidence":0.3,"snippet":"Hand clenching — Occasional (29-5%)"}],"contradicting":[],"confidence":0.3,"independent_sources":["Orphanet"],"level":"curated"},"confidence