{"node":{"id":"HP:0000062","label":"Ambiguous genitalia","ic":4.542,"definition":"A genital phenotype that is not clearly assignable to a single gender. Ambiguous genitalia can be evaluated using the Prader scale: Prader 0: Normal female external genitalia. Prader 1: Female external genitalia with clitoromegaly. Prader 2: Clitoromegaly with partial labial fusion forming a funnel-shaped urogenital sinus. Prader 3: Increased phallic enlargement. Complete labioscrotal fusion forming a urogenital sinus with a single opening. Prader 4: Complete scrotal fusion with urogenital opening at the base or on the shaft of the phallus. Prader 5: Normal male external genitalia. The diagnosis of ambiguous genitalia is made for Prader 1-4."},"diseases":[{"id":"MONDO:0971174","label":"multiple mitochondrial dysfunctions syndrome 9b","in_core":false,"edge":{"id":"e_f63a1cf011fa","source":"MONDO:0971174","target":"HP:0000062","type":"has_phenotype","evidence":[{"db":"HPO","origin":"OMIM","record":"OMIM:620887 · PMID:30250212","url":"https://pubmed.ncbi.nlm.nih.gov/30250212/","level":"observed","date":"2025-12-07","confidence":1.0,"snippet":"Multiple mitochondrial dysfunctions syndrome 9B: Ambiguous genitalia (frequency 1/1) [PCS]"}],"contradicting":[],"confidence":1.0,"independent_sources":["OMIM"],"level":"observed"},"confidence":1.0},{"id":"MONDO:0010519","label":"alpha thalassemia-X-linked intellectual disability syndrome","in_core":false,"edge":{"id":"e_a806ed8054a4","source":"MONDO:0010519","target":"HP:0000062","type":"has_phenotype","evidence":[{"db":"HPO","origin":"Orphanet","record":"ORPHA:847 · ORPHA:847","url":"https://www.orpha.net/en/disease/detail/847","level":"curated","date":"2026-09-02","confidence":0.9,"snippet":"X-linked alpha-thalassemia-intellectual disability syndrome: Ambiguous genitalia (frequency HP:0040281) [TAS]"},{"db":"Orphanet","origin":"Orphanet","record":"ORPHA:847","level":"curated","date":"2026-06-23","url":"https://www.orpha.net/en/disease/detail/847",