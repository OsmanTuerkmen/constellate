# copy to .env.local (root, for pipeline) and app/.env.local (for Next.js). never commit real keys.
OPENAI_API_KEY=
NCBI_API_KEY=            # optional, raises PubMed/ClinVar rate limit 3 -> 10 req/s
BRIGHTDATA_API_KEY=      # optional, patient-org page fetching
BRIGHTDATA_ZONE=         # optional, Web Unlocker zone name from the Bright Data dashboard
ELEVENLABS_API_KEY=      # optional, read-aloud feature + video voice-over
